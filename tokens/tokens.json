{
  "$description": "Three-tier design tokens for portfolio.blinkwiser.com (W3C DTCG format). Tier 1 primitive: raw values. Tier 2 semantic: intent, with light/dark modes. Tier 3 component: what each component consumes. Themes override the accent at tier 2 only, so every component re-themes without being touched. Run `npm run tokens` to regenerate src/styles/tokens.css.",

  "primitive": {
    "color": {
      "neutral": {
        "0":    { "$type": "color", "$value": "oklch(99.4% 0.002 85)" },
        "25":   { "$type": "color", "$value": "oklch(98.2% 0.004 85)" },
        "50":   { "$type": "color", "$value": "oklch(96.6% 0.005 85)" },
        "100":  { "$type": "color", "$value": "oklch(94.2% 0.006 85)" },
        "200":  { "$type": "color", "$value": "oklch(90.2% 0.007 85)" },
        "300":  { "$type": "color", "$value": "oklch(83.5% 0.008 85)" },
        "400":  { "$type": "color", "$value": "oklch(70.5% 0.009 85)" },
        "500":  { "$type": "color", "$value": "oklch(58.5% 0.01 85)" },
        "600":  { "$type": "color", "$value": "oklch(48.5% 0.01 85)" },
        "700":  { "$type": "color", "$value": "oklch(38.5% 0.01 85)" },
        "800":  { "$type": "color", "$value": "oklch(28% 0.009 85)" },
        "850":  { "$type": "color", "$value": "oklch(23.5% 0.008 85)" },
        "900":  { "$type": "color", "$value": "oklch(19.5% 0.007 85)" },
        "950":  { "$type": "color", "$value": "oklch(15.5% 0.006 85)" },
        "1000": { "$type": "color", "$value": "oklch(12.5% 0.005 85)" }
      },
      "ultramarine": {
        "500": { "$type": "color", "$value": "oklch(49% 0.22 268)" },
        "600": { "$type": "color", "$value": "oklch(42% 0.21 268)" },
        "300": { "$type": "color", "$value": "oklch(76% 0.12 268)" },
        "200": { "$type": "color", "$value": "oklch(84% 0.08 268)" }
      },
      "violet": {
        "500": { "$type": "color", "$value": "oklch(50% 0.2 300)" },
        "600": { "$type": "color", "$value": "oklch(43% 0.19 300)" },
        "300": { "$type": "color", "$value": "oklch(77% 0.12 300)" },
        "200": { "$type": "color", "$value": "oklch(85% 0.075 300)" }
      },
      "vermilion": {
        "500": { "$type": "color", "$value": "oklch(54% 0.165 45)" },
        "600": { "$type": "color", "$value": "oklch(47% 0.15 45)" },
        "300": { "$type": "color", "$value": "oklch(79% 0.12 55)" },
        "200": { "$type": "color", "$value": "oklch(87% 0.07 58)" }
      },
      "cobalt": {
        "500": { "$type": "color", "$value": "oklch(50% 0.16 245)" },
        "600": { "$type": "color", "$value": "oklch(43% 0.15 245)" },
        "300": { "$type": "color", "$value": "oklch(78% 0.1 240)" },
        "200": { "$type": "color", "$value": "oklch(86% 0.06 240)" }
      },
      "teal": {
        "500": { "$type": "color", "$value": "oklch(50% 0.1 180)" },
        "600": { "$type": "color", "$value": "oklch(43% 0.09 180)" },
        "300": { "$type": "color", "$value": "oklch(79% 0.1 178)" },
        "200": { "$type": "color", "$value": "oklch(87% 0.06 178)" }
      },
      "sand": {
        "500": { "$type": "color", "$value": "oklch(53% 0.11 80)" },
        "600": { "$type": "color", "$value": "oklch(46% 0.1 80)" },
        "300": { "$type": "color", "$value": "oklch(82% 0.11 88)" },
        "200": { "$type": "color", "$value": "oklch(89% 0.065 90)" }
      },
      "signal": {
        "positive": { "$type": "color", "$value": "oklch(52% 0.13 150)" },
        "positive-dark": { "$type": "color", "$value": "oklch(78% 0.14 150)" },
        "critical": { "$type": "color", "$value": "oklch(52% 0.19 27)" },
        "critical-dark": { "$type": "color", "$value": "oklch(74% 0.14 27)" }
      },
      "white": { "$type": "color", "$value": "#ffffff" },
      "black": { "$type": "color", "$value": "#000000" }
    },
    "space": {
      "0":  { "$type": "dimension", "$value": "0px" },
      "1":  { "$type": "dimension", "$value": "2px" },
      "2":  { "$type": "dimension", "$value": "4px" },
      "3":  { "$type": "dimension", "$value": "8px" },
      "4":  { "$type": "dimension", "$value": "12px" },
      "5":  { "$type": "dimension", "$value": "16px" },
      "6":  { "$type": "dimension", "$value": "20px" },
      "7":  { "$type": "dimension", "$value": "24px" },
      "8":  { "$type": "dimension", "$value": "32px" },
      "9":  { "$type": "dimension", "$value": "40px" },
      "10": { "$type": "dimension", "$value": "48px" },
      "11": { "$type": "dimension", "$value": "64px" },
      "12": { "$type": "dimension", "$value": "80px" },
      "13": { "$type": "dimension", "$value": "96px" },
      "14": { "$type": "dimension", "$value": "128px" },
      "15": { "$type": "dimension", "$value": "160px" }
    },
    "radius": {
      "xs":   { "$type": "dimension", "$value": "3px" },
      "sm":   { "$type": "dimension", "$value": "6px" },
      "md":   { "$type": "dimension", "$value": "10px" },
      "lg":   { "$type": "dimension", "$value": "16px" },
      "xl":   { "$type": "dimension", "$value": "24px" },
      "pill": { "$type": "dimension", "$value": "999px" }
    },
    "font": {
      "family": {
        "sans":  { "$type": "fontFamily", "$value": "var(--font-geist), ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif" },
        "serif": { "$type": "fontFamily", "$value": "var(--font-instrument), ui-serif, Georgia, serif" },
        "mono":  { "$type": "fontFamily", "$value": "var(--font-geist-mono), ui-monospace, 'SF Mono', Menlo, monospace" },
        "arabic": { "$type": "fontFamily", "$value": "var(--font-arabic), 'Geeza Pro', 'Noto Sans Arabic', sans-serif" }
      },
      "size": {
        "display-xl": { "$type": "dimension", "$value": "clamp(2.75rem, 1.35rem + 5.6vw, 6.25rem)" },
        "display-l":  { "$type": "dimension", "$value": "clamp(2.25rem, 1.4rem + 3.4vw, 4.25rem)" },
        "display-m":  { "$type": "dimension", "$value": "clamp(1.875rem, 1.35rem + 2.1vw, 3.125rem)" },
        "heading-l":  { "$type": "dimension", "$value": "clamp(1.5rem, 1.25rem + 1vw, 2.125rem)" },
        "heading-m":  { "$type": "dimension", "$value": "clamp(1.1875rem, 1.1rem + 0.35vw, 1.4375rem)" },
        "body-l":     { "$type": "dimension", "$value": "clamp(1.0625rem, 1rem + 0.3vw, 1.25rem)" },
        "body-m":     { "$type": "dimension", "$value": "1rem" },
        "body-s":     { "$type": "dimension", "$value": "0.875rem" },
        "label":      { "$type": "dimension", "$value": "0.75rem" },
        "micro":      { "$type": "dimension", "$value": "0.6875rem" }
      },
      "weight": {
        "regular":  { "$type": "fontWeight", "$value": 400 },
        "medium":   { "$type": "fontWeight", "$value": 500 },
        "semibold": { "$type": "fontWeight", "$value": 600 }
      },
      "leading": {
        "tight":  { "$type": "number", "$value": 0.98 },
        "snug":   { "$type": "number", "$value": 1.15 },
        "normal": { "$type": "number", "$value": 1.5 },
        "relaxed":{ "$type": "number", "$value": 1.65 }
      },
      "tracking": {
        "display": { "$type": "dimension", "$value": "-0.035em" },
        "heading": { "$type": "dimension", "$value": "-0.02em" },
        "body":    { "$type": "dimension", "$value": "-0.005em" },
        "label":   { "$type": "dimension", "$value": "0.08em" }
      }
    },
    "duration": {
      "instant": { "$type": "duration", "$value": "90ms" },
      "fast":    { "$type": "duration", "$value": "160ms" },
      "base":    { "$type": "duration", "$value": "260ms" },
      "slow":    { "$type": "duration", "$value": "480ms" },
      "slower":  { "$type": "duration", "$value": "900ms" }
    },
    "ease": {
      "standard":   { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
      "emphasized": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] },
      "exit":       { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1] }
    },
    "layout": {
      "max":    { "$type": "dimension", "$value": "1320px" },
      "prose":  { "$type": "dimension", "$value": "68ch" },
      "gutter": { "$type": "dimension", "$value": "clamp(16px, 4vw, 48px)" }
    }
  },

  "semantic": {
    "surface": {
      "canvas":  { "$type": "color", "$value": "{primitive.color.neutral.25}",  "$extensions": { "mode": { "dark": "{primitive.color.neutral.1000}" } } },
      "raised":  { "$type": "color", "$value": "{primitive.color.neutral.0}",   "$extensions": { "mode": { "dark": "{primitive.color.neutral.950}" } } },
      "sunken":  { "$type": "color", "$value": "{primitive.color.neutral.50}",  "$extensions": { "mode": { "dark": "{primitive.color.neutral.900}" } } },
      "muted":   { "$type": "color", "$value": "{primitive.color.neutral.100}", "$extensions": { "mode": { "dark": "{primitive.color.neutral.850}" } } },
      "inverse": { "$type": "color", "$value": "{primitive.color.neutral.950}", "$extensions": { "mode": { "dark": "{primitive.color.neutral.50}" } } }
    },
    "text": {
      "primary":   { "$type": "color", "$value": "{primitive.color.neutral.950}", "$extensions": { "mode": { "dark": "{primitive.color.neutral.25}" } } },
      "secondary": { "$type": "color", "$value": "{primitive.color.neutral.700}", "$extensions": { "mode": { "dark": "{primitive.color.neutral.300}" } } },
      "tertiary":  { "$type": "color", "$value": "{primitive.color.neutral.600}", "$extensions": { "mode": { "dark": "{primitive.color.neutral.400}" } } },
      "inverse":   { "$type": "color", "$value": "{primitive.color.neutral.25}",  "$extensions": { "mode": { "dark": "{primitive.color.neutral.950}" } } },
      "positive":  { "$type": "color", "$value": "{primitive.color.signal.positive}", "$extensions": { "mode": { "dark": "{primitive.color.signal.positive-dark}" } } },
      "critical":  { "$type": "color", "$value": "{primitive.color.signal.critical}", "$extensions": { "mode": { "dark": "{primitive.color.signal.critical-dark}" } } }
    },
    "border": {
      "subtle":  { "$type": "color", "$value": "{primitive.color.neutral.200}", "$extensions": { "mode": { "dark": "{primitive.color.neutral.850}" } } },
      "default": { "$type": "color", "$value": "{primitive.color.neutral.300}", "$extensions": { "mode": { "dark": "{primitive.color.neutral.800}" } } },
      "strong":  { "$type": "color", "$value": "{primitive.color.neutral.500}", "$extensions": { "mode": { "dark": "{primitive.color.neutral.500}" } } }
    },
    "accent": {
      "solid":    { "$type": "color", "$value": "{primitive.color.ultramarine.500}", "$extensions": { "mode": { "dark": "{primitive.color.ultramarine.300}" } } },
      "strong":   { "$type": "color", "$value": "{primitive.color.ultramarine.600}", "$extensions": { "mode": { "dark": "{primitive.color.ultramarine.200}" } } },
      "soft":     { "$type": "color", "$value": "color-mix(in oklch, {primitive.color.ultramarine.500} 9%, {primitive.color.neutral.0})", "$extensions": { "mode": { "dark": "color-mix(in oklch, {primitive.color.ultramarine.300} 14%, {primitive.color.neutral.950})" } } },
      "on-solid": { "$type": "color", "$value": "{primitive.color.white}", "$extensions": { "mode": { "dark": "{primitive.color.neutral.1000}" } } }
    },
    "focus": {
      "ring": { "$type": "color", "$value": "{semantic.accent.solid}" }
    },
    "shadow": {
      "raised":  { "$type": "shadow", "$value": "0 1px 0 0 oklch(0% 0 0 / 0.04), 0 1px 2px -1px oklch(0% 0 0 / 0.06), 0 8px 24px -12px oklch(0% 0 0 / 0.10)", "$extensions": { "mode": { "dark": "0 0 0 1px oklch(100% 0 0 / 0.04), 0 16px 40px -16px oklch(0% 0 0 / 0.6)" } } },
      "overlay": { "$type": "shadow", "$value": "0 2px 4px -2px oklch(0% 0 0 / 0.06), 0 24px 64px -24px oklch(0% 0 0 / 0.22)", "$extensions": { "mode": { "dark": "0 0 0 1px oklch(100% 0 0 / 0.06), 0 32px 80px -24px oklch(0% 0 0 / 0.75)" } } }
    },
    "motion": {
      "enter":    { "$type": "transition", "$value": "{primitive.duration.slow} {primitive.ease.emphasized}" },
      "hover":    { "$type": "transition", "$value": "{primitive.duration.fast} {primitive.ease.standard}" },
      "state":    { "$type": "transition", "$value": "{primitive.duration.base} {primitive.ease.standard}" }
    }
  },

  "component": {
    "button": {
      "height":        { "$type": "dimension", "$value": "44px" },
      "radius":        { "$type": "dimension", "$value": "{primitive.radius.pill}" },
      "primary-bg":    { "$type": "color", "$value": "{semantic.text.primary}" },
      "primary-fg":    { "$type": "color", "$value": "{semantic.text.inverse}" },
      "secondary-bg":  { "$type": "color", "$value": "transparent" },
      "secondary-fg":  { "$type": "color", "$value": "{semantic.text.primary}" },
      "secondary-border": { "$type": "color", "$value": "{semantic.border.default}" }
    },
    "card": {
      "bg":      { "$type": "color", "$value": "{semantic.surface.raised}" },
      "border":  { "$type": "color", "$value": "{semantic.border.subtle}" },
      "radius":  { "$type": "dimension", "$value": "{primitive.radius.lg}" },
      "shadow":  { "$type": "shadow", "$value": "{semantic.shadow.raised}" }
    },
    "chip": {
      "bg":     { "$type": "color", "$value": "{semantic.surface.muted}" },
      "fg":     { "$type": "color", "$value": "{semantic.text.secondary}" },
      "radius": { "$type": "dimension", "$value": "{primitive.radius.pill}" }
    },
    "fork": {
      "rejected-fg":    { "$type": "color", "$value": "{semantic.text.tertiary}" },
      "rejected-bg":    { "$type": "color", "$value": "{semantic.surface.sunken}" },
      "chosen-border":  { "$type": "color", "$value": "{semantic.accent.solid}" },
      "chosen-bg":      { "$type": "color", "$value": "{semantic.surface.raised}" },
      "path":           { "$type": "color", "$value": "{semantic.border.strong}" }
    },
    "rail": {
      "track":  { "$type": "color", "$value": "{semantic.border.subtle}" },
      "active": { "$type": "color", "$value": "{semantic.accent.solid}" }
    },
    "metric": {
      "before": { "$type": "color", "$value": "{semantic.border.default}" },
      "after":  { "$type": "color", "$value": "{semantic.accent.solid}" }
    },
    "exhibit": {
      "bg":     { "$type": "color", "$value": "{semantic.surface.sunken}" },
      "border": { "$type": "color", "$value": "{semantic.border.subtle}" },
      "radius": { "$type": "dimension", "$value": "{primitive.radius.xl}" }
    }
  },

  "themes": {
    "$description": "Per-case-study accent themes. Each overrides only the semantic accent tier, exactly like a client brand on a white-label platform.",
    "automation": { "palette": "violet" },
    "blinkwiser": { "palette": "vermilion" },
    "platform":   { "palette": "cobalt" },
    "enrollment": { "palette": "teal" },
    "civic":      { "palette": "sand" }
  }
}
